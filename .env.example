# Primary LLM provider: OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Other providers can stay unset even if your shell has unrelated keys.
# GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...

# Real LangGraph HITL: approval_node calls interrupt() and CLI resumes with Command(resume=...).
LANGGRAPH_INTERRUPT=true

# Used only when real HITL is disabled.
# MOCK_APPROVAL=true

# Persistence backend used by configs/lab.yaml (memory is enough for same-process HITL resume).
CHECKPOINTER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab

LOG_LEVEL=INFO
